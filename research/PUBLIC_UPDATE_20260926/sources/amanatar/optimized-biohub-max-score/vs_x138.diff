+# ---------------------------------------------------------------------- #
+# v9 RUNTIME GOVERNOR (9 h wall, x138/v5.1-proven scale). Measured from the
+# true kernel start (anchored in Cell 1). The guards are a safety net on the
+# hidden rerun: silent while the pipeline runs inside the proven budget,
+# degrading in bounded, verifiable steps instead of a timeout:
+#   1. per-dataset repair cap  -> one oversized dataset cannot eat hours
+#   2. repair deadline         -> remaining datasets ship edge filtering
+#   3. validator/sweep gates   -> skipped when out of budget
+#   4. rewrite fit-guard       -> pass-2 only with measured room to finish
+# At visible-run scale no gate trips and the floor is EXACTLY x138.
+# ---------------------------------------------------------------------- #
+import time as _v7_time
+
+_V7_DATASET_T0: dict[str, float] = {"t0": 0.0}
+
+
+def v7_kernel_elapsed() -> float:
+    return _v7_time.time() - KERNEL_START_TS
+
+
+def v7_gate_ok(gate_env: str, label: str) -> bool:
+    """True unless the kernel has already run past the named start gate."""
+    latest = float(os.environ.get(gate_env, "0") or 0.0)
+    if latest <= 0.0:
+        return True
+    elapsed = v7_kernel_elapsed()
+    if elapsed >= latest:
+        print(
+            f"V7 GATE [{label}]: skipped -- kernel elapsed {elapsed:.0f}s >= "
+            f"{gate_env}={latest:.0f}s",
+            flush=True,
+        )
+        return False
+    return True
+
+
+def v7_deadline_hit(env_key: str) -> bool:
+    limit = float(os.environ.get(env_key, "0") or 0.0)
+    return limit > 0.0 and v7_kernel_elapsed() >= limit
+
+
+def _repair_overrun() -> bool:
+    """Per-dataset repair budget: one oversized dataset cannot eat the wall."""
+    cap = float(os.environ.get("BIOHUB_REPAIR_PER_DATASET_CAP_S", "0") or 0.0)
+    return cap > 0.0 and (_v7_time.time() - _V7_DATASET_T0["t0"]) >= cap
+
+
+def _v7_repair_stage_checkpoint(dataset: str | None) -> None:
+    """Called between repair stages inside filter_output_graph."""
+    if not _deadline_degraded and _repair_overrun():
+        print(
+            f"  [{dataset}] V7: per-dataset repair cap "
+            f"{os.environ.get('BIOHUB_REPAIR_PER_DATASET_CAP_S', '0')}s reached;"
+            " degrading the remaining stages of this dataset",
+            flush=True,
+        )
+        _deadline_degrade()
+
+
+def _pp_apply_frozen_overrides(overrides: dict) -> dict:
+    """Apply frozen-preset post-process overrides to the module globals and
+    return the saved previous values. Unknown keys fail loud."""
+    saved = {}
+    for key, value in overrides.items():
+        current = globals().get(key)
+        if current is None:
+            raise RuntimeError(f"V7 frozen preset: unknown post-process key {key!r}")
+        saved[key] = current
+        globals()[key] = type(current)(value)
+    return saved
+
+
+def _v9_rewrite_fits() -> bool:
+    """v9: attempt the pass-2 rewrite only when the measured base-pass cost
+    still fits before the rewrite deadline. A mid-rewrite deadline degrade
+    would mix a weaker config into submission.csv, so when in doubt the
+    untouched base submission ships (exact x138 behavior)."""
+    limit = float(os.environ.get("BIOHUB_REWRITE_DEADLINE_S", "0") or 0.0)
+    if limit <= 0.0:
+        return True
+    base_cost = float(globals().get("_V9_REPAIR_SECONDS", 0.0) or 0.0)
+    need = base_cost * 1.15 + 30.0
+    room = limit - v7_kernel_elapsed()
+    if room >= need:
+        return True
+    globals()["_V9_REWRITE_FIT_SKIPPED"] = True
+    print(
+        f"V9: pass-2 rewrite skipped -- measured base pass {base_cost:.0f}s x1.15 + 30s "
+        f"= {need:.0f}s exceeds the {room:.0f}s left before "
+        f"BIOHUB_REWRITE_DEADLINE_S={limit:.0f}s; shipping the base submission.csv.",
+        flush=True,
+    )
+    return False
