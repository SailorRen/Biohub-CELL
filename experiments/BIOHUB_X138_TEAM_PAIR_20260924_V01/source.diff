+        "velocity_environment": os.environ.get("BIOHUB_MOTION_RELINK_VELOCITY_WEIGHT"),
+        "flow_mode": MOTION_RELINK_FLOW_MODE,
+        "head_mode": os.environ.get("V1284_MODE"),
+        "head": _pair_file(os.environ.get("V1284_HEAD", "")),
