+import hashlib as _pair_hashlib
+from datetime import datetime as _pair_datetime, timezone as _pair_timezone
+try:
+    def _pair_file(path):
+        path = Path(path)
+        if not path.is_file():
+            return {"path": str(path), "status": "NOT_FOUND"}
+        h = _pair_hashlib.sha256()
+        with path.open("rb") as stream:
