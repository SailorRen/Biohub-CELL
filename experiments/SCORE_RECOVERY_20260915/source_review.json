  "method": {
    "model": "L2逻辑回归；10个标准化几何/运动特征及各自平方项加截距，共21系数",
    "features": [
      "父到女儿较小距离",
      "父到女儿较大距离",
      "姐妹距离",
      "姐妹中点到父距离",
      "父女距离相对不对称度",
      "两女儿方向夹角余弦",
      "孙女间距",
      "姐妹至孙女间距变化",
      "两女儿速度均值",
      "两女儿速度差绝对值"
    ],
    "source_reference": "cell4 DIVISION_SOURCE lines35-49,116-146",
    "optimizer": "scipy.optimize.minimize L-BFGS-B, maxiter250, ridge0.003, seed20260914",
    "augmentation": "只在当前训练分区内原始坐标加3份独立0.35µm高斯扰动，合计4倍",
    "normalization": "由训练分区增强样本计算mean/std，scale下限0.1；标准化后clip[-8,8]",
