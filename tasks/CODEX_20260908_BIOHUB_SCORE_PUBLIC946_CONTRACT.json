        "0.939",
        "browser"
      ]
    },
    {
      "id": "tta-source-audit",
      "type": "file",
      "required": true,
      "path": "research/20260908_正式成绩与公开946对比/tta_源码审读.json",
      "min_bytes": 1000
    },
    {
      "id": "harmonic-source-audit",
      "type": "file",
      "required": true,
      "path": "research/20260908_正式成绩与公开946对比/harmonic_源码审读.json",
      "min_bytes": 1000
    },
    {
      "id": "comparison-report",
      "type": "file",
